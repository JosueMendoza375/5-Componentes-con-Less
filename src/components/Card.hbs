<div class="col-12 col-l-4">
    <article class="card" data-role="card">
        <div class="card-image">
            <img src="{{img}}" alt="{{titulo}}" />
        </div>
        <div class="card-content">
            <div class="media">
                <img class="media-left" src="{{img}}" alt="" />
                <h3 class="card-title">{{titulo}}</h3>
            </div>
            <p>{{texto}}</p>
        </div>
    </article>
</div>
